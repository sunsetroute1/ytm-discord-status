{
  "client_id": "YOUR_DISCORD_APP_CLIENT_ID",
  "poll_interval_seconds": 5,
  "clear_on_pause": true,
  "reconnect_interval_seconds": 15,
  "display_mode": "override",
  "show_artwork": true,
  "artwork_webhook": null,
  "whitelist": [
    "spotify",
    "apple_music",
    "amazon_music",
    "deezer",
    "tidal",
    "soundcloud",
    "pandora",
    "iheart",
    "qobuz",
    "napster",
    "youtube_music_app",
    "winamp",
    "foobar2000",
    "musicbee",
    "aimp",
    "itunes",
    "mediamonkey",
    "quodlibet",
    "clementine",
    "strawberry",
    "rhythmbox",
    "musicplayer2",
    "dopamine",
    "neutron"
  ],
  "allow_browsers": true,
  "browser_require_catalog_match": true,
  "listen_button": {
    "enabled": true,
    "label": "Listen on YouTube Music",
    "target": "youtube_music"
  },
  "presence": {
    "large_text": "Music",
    "small_text": ""
  }
}
